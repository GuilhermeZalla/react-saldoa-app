# For Android emulator, Laravel running on the same computer is usually
# reachable at http://10.0.2.2:8000. For a physical device, use your computer's
# LAN IP. Public deployments must use HTTPS.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Configure only for a separately deployed demo instance and database.
EXPO_PUBLIC_API_URL_DEMO=

# Public Laravel web URL, used for the existing password recovery page.
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:8000
