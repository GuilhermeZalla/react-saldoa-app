{
	email {$TLS_EMAIL}
}

{$SALDOA_HOST} {
	root * /var/www/html/public
	encode zstd gzip

	@hidden path /.env* /.git/*
	respond @hidden 404

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	php_fastcgi app:9000
	file_server
}
