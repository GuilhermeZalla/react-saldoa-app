# Copy to .env.production on the server only. Never commit the populated file.
# Public hostname only, without scheme, slash, path or port.
SALDOA_HOST=replace-me.duckdns.org
TLS_EMAIL=replace-me@example.com
SALDOA_IMAGE_TAG=initial

# Generate once: openssl rand -base64 32 (prefix the result with base64:).
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
DB_DATABASE=saldoa
DB_USERNAME=saldoa
# Generate: openssl rand -hex 32. This is distinct from the MySQL root secret.
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Use a real SMTP service and a sender authorized by that service.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=verified-sender@example.com
