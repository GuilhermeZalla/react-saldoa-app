[Unit]
Description=Encrypted Saldoa backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecCondition=/usr/bin/python3 /usr/local/lib/saldoa/backup-due.py
ExecStart=/usr/local/sbin/saldoa-backup
TimeoutStartSec=900
